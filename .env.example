# Aletheia configuration — copy this file to ".env" and fill in your key.
#
#   cp .env.example .env      then edit .env and paste your key after the =
#
# The .env file is git-ignored, so your secret key NEVER gets committed.
# Get an API key at https://console.anthropic.com  (Settings → API Keys).

# Your Claude API key. Leave this EMPTY to run in free offline mode; paste your
# key right after the = to enable live Claude answers, e.g.
#   ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# Optional: override the default model (default is claude-opus-4-8).
# Cheaper/faster options: claude-sonnet-4-6, claude-haiku-4-5
# ALETHEIA_LLM_MODEL=claude-sonnet-4-6
